<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card_purple"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_booking_category"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="CONCERT"
            android:textColor="@color/text_muted" android:textSize="11sp" android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_active_badge"
            android:paddingHorizontal="12dp" android:paddingVertical="4dp"
            android:text="Active" android:textColor="@color/white" android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_booking_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Event Title"
        android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tv_booking_date"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Date"
            android:textColor="@color/text_muted" android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_booking_price"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_price_chip"
            android:paddingHorizontal="12dp" android:paddingVertical="4dp"
            android:text="Tsh 0" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@drawable/bg_dashed_divider" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Ticket No." android:textColor="@color/text_muted" android:textSize="11sp" />
            <TextView
                android:id="@+id/tv_booking_ticket"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="BKF-0000-0000"
                android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="60dp" android:layout_height="60dp"
            android:background="@drawable/bg_qr_placeholder" />
    </LinearLayout>

</LinearLayout>