<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorAppBackground">

    <!-- Bottom nav bar -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/colorAppSurface"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_nav_home" app:tint="@color/primary_purple" android:contentDescription="@string/nav_home" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_home" android:textColor="@color/primary_purple" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_explore" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_nav_explore" app:tint="?attr/colorAppTextMuted" android:contentDescription="@string/nav_explore" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_explore" android:textColor="?attr/colorAppTextMuted" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_tickets" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_ticket" app:tint="?attr/colorAppTextMuted" android:contentDescription="@string/nav_tickets" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_tickets" android:textColor="?attr/colorAppTextMuted" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_profile" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_nav_profile" app:tint="?attr/colorAppTextMuted" android:contentDescription="@string/nav_profile" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_profile" android:textColor="?attr/colorAppTextMuted" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable content above nav bar -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?attr/colorAppBackground"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="52dp"
                android:paddingBottom="16dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_good_morning"
                        android:textColor="?attr/colorAppTextMuted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sarah ✨"
                        android:textColor="?attr/colorAppTextPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_avatar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:text="SJ"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Search bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/colorAppTextMuted"
                    android:contentDescription="@string/search_hint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/search_hint"
                    android:textColor="?attr/colorAppTextMuted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Category chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <TextView
                        android:id="@+id/chip_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_selected"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="8dp"
                        android:text="@string/category_all"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chip_concerts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_default"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="8dp"
                        android:text="@string/category_concerts"
                        android:textColor="?attr/colorAppTextMuted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chip_sports"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_default"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="8dp"
                        android:text="@string/category_sports"
                        android:textColor="?attr/colorAppTextMuted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chip_conference"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_default"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="8dp"
                        android:text="@string/category_conference"
                        android:textColor="?attr/colorAppTextMuted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chip_gala"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_default"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="8dp"
                        android:text="@string/category_gala"
                        android:textColor="?attr/colorAppTextMuted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chip_party"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_default"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="8dp"
                        android:text="@string/category_party"
                        android:textColor="?attr/colorAppTextMuted"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Section header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/nearby_events"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/see_all"
                    android:textColor="?attr/colorAppTextMuted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Events list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_events"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="20dp" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_input_add"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:backgroundTint="@color/primary_purple"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>