<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorAppBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btn_save"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_dashboard_title"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_logout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/admin_logout"
                    android:textColor="@color/primary_purple"
                    android:textSize="14sp" />
            </RelativeLayout>

            <!-- Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_admin_input"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:id="@+id/tv_total_users"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="?attr/colorAppTextPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_stat_users"
                        android:textColor="?attr/colorAppTextMuted"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_admin_input"
                    android:padding="12dp"
                    android:layout_marginHorizontal="6dp">
                    <TextView
                        android:id="@+id/tv_total_events"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="?attr/colorAppTextPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_stat_events"
                        android:textColor="?attr/colorAppTextMuted"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_admin_input"
                    android:padding="12dp"
                    android:layout_marginStart="6dp">
                    <TextView
                        android:id="@+id/tv_total_revenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0k"
                        android:textColor="?attr/colorAppTextPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_stat_revenue"
                        android:textColor="?attr/colorAppTextMuted"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Image Picker -->
            <RelativeLayout
                android:id="@+id/layout_select_image"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_admin_input"
                android:layout_marginBottom="24dp">
                <ImageView
                    android:id="@+id/iv_event_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:alpha="0.4"
                    android:src="@drawable/bg_qr_placeholder" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/admin_select_event_picture"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>
            </RelativeLayout>

            <EditText
                android:id="@+id/et_title"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_admin_input"
                android:hint="@string/admin_event_title_hint"
                android:paddingHorizontal="20dp"
                android:textColor="?attr/colorAppTextPrimary"
                android:textColorHint="?attr/colorAppTextMuted"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/et_category"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_admin_input"
                android:hint="@string/admin_category_hint"
                android:paddingHorizontal="20dp"
                android:textColor="?attr/colorAppTextPrimary"
                android:textColorHint="?attr/colorAppTextMuted"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <EditText
                    android:id="@+id/et_location"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_admin_input"
                    android:hint="@string/admin_location_hint"
                    android:paddingHorizontal="20dp"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textColorHint="?attr/colorAppTextMuted"
                    android:textSize="15sp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_location"
                    android:layout_width="wrap_content"
                    android:layout_height="54dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/admin_pin_button"
                    app:backgroundTint="?attr/colorAppSurface" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <EditText
                    android:id="@+id/et_date"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_admin_input"
                    android:hint="@string/admin_date_hint"
                    android:paddingHorizontal="20dp"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textColorHint="?attr/colorAppTextMuted"
                    android:textSize="15sp"
                    android:layout_marginEnd="8dp"/>
                <EditText
                    android:id="@+id/et_time"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_admin_input"
                    android:hint="@string/admin_time_hint"
                    android:paddingHorizontal="20dp"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textColorHint="?attr/colorAppTextMuted"
                    android:textSize="15sp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <EditText
                    android:id="@+id/et_price"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_admin_input"
                    android:hint="@string/admin_price_hint"
                    android:paddingHorizontal="20dp"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textColorHint="?attr/colorAppTextMuted"
                    android:textSize="15sp"
                    android:layout_marginEnd="8dp"/>
                <EditText
                    android:id="@+id/et_slots"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_admin_input"
                    android:hint="@string/admin_slots_hint"
                    android:paddingHorizontal="20dp"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textColorHint="?attr/colorAppTextMuted"
                    android:textSize="15sp"
                    android:inputType="number"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <EditText
                android:id="@+id/et_description"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_admin_input"
                android:hint="@string/admin_description_hint"
                android:gravity="top"
                android:padding="20dp"
                android:textColor="?attr/colorAppTextPrimary"
                android:textColorHint="?attr/colorAppTextMuted"
                android:textSize="15sp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tv_user_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/admin_view_as_user"
                android:textColor="?attr/colorAppTextMuted"
                android:textSize="14sp"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_all_users_title"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <Button
                    android:id="@+id/btn_add_promoter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/admin_add_promoter_button"
                    android:backgroundTint="@color/primary_purple"
                    android:textColor="@color/white"
                    android:textSize="12sp"/>
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_users"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_pending_applications_title"
                android:textColor="?attr/colorAppTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tv_no_applications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/admin_no_pending_applications"
                android:textColor="?attr/colorAppTextMuted"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_promoter_applications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_manage_events_title"
                android:textColor="?attr/colorAppTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_admin_events"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="20dp"
        android:backgroundTint="@color/primary_purple"
        android:text="@string/admin_post_event_now"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
