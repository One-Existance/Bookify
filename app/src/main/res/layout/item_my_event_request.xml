<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="?attr/colorAppSurface"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_my_request_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorAppTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_my_request_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_active_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_my_request_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/colorAppTextMuted"
        android:textSize="13sp"/>

    <LinearLayout
        android:id="@+id/layout_share_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_share_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/primary_purple"
            android:text="@string/share_invite_code"
            android:textColor="@color/white"
            android:textSize="13sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share_whatsapp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/whatsapp_green"
            android:text="@string/share_via_whatsapp"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:icon="@drawable/ic_chat"
            app:iconTint="@color/white"
            app:iconGravity="textStart" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_scan_entry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/scan_entry_title"
        android:textColor="@color/primary_purple"
        android:textSize="13sp"
        app:icon="@drawable/ic_qr_scanner"
        app:iconTint="@color/primary_purple"
        app:iconGravity="textStart"
        app:strokeColor="@color/primary_purple"
        android:visibility="gone"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

</LinearLayout>
