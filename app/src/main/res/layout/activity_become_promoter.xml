<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorAppBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btn_submit"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/promoter_become_title"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/nav_back_arrow"
                    android:textColor="@color/primary_purple"
                    android:textSize="14sp" />
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/promoter_become_desc"
                android:textColor="?attr/colorAppTextMuted"
                android:textSize="13sp"
                android:layout_marginBottom="24dp"/>

            <EditText
                android:id="@+id/et_hall_name"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_admin_input"
                android:hint="@string/promoter_hall_name_hint"
                android:paddingHorizontal="20dp"
                android:textColor="?attr/colorAppTextPrimary"
                android:textColorHint="?attr/colorAppTextMuted"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/et_location"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_admin_input"
                android:hint="@string/promoter_location_hint"
                android:paddingHorizontal="20dp"
                android:textColor="?attr/colorAppTextPrimary"
                android:textColorHint="?attr/colorAppTextMuted"
                android:textSize="15sp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pick_on_map"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/promoter_pick_on_map"
                android:textColor="@color/primary_purple"
                app:strokeColor="@color/primary_purple"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <EditText
                android:id="@+id/et_description"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_admin_input"
                android:hint="@string/promoter_hall_desc_hint"
                android:gravity="top"
                android:padding="20dp"
                android:textColor="?attr/colorAppTextPrimary"
                android:textColorHint="?attr/colorAppTextMuted"
                android:textSize="15sp"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_submit"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="20dp"
        android:backgroundTint="@color/primary_purple"
        android:text="@string/promoter_submit_application"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
