<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorAppBackground">

    <ProgressBar
        android:id="@+id/progress_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_save_changes"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_event_title"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/nav_back_arrow"
                    android:textColor="@color/primary_purple"
                    android:textSize="14sp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tv_past_event_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_admin_input"
                android:padding="14dp"
                android:text="@string/edit_event_past_event_message"
                android:textColor="@color/error_red"
                android:textSize="13sp"
                android:visibility="gone"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_admin_input"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/organize_private_event_label"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textSize="15sp"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_private"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Image Picker -->
            <RelativeLayout
                android:id="@+id/layout_select_image"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_admin_input"
                android:layout_marginBottom="24dp">
                <ImageView
                    android:id="@+id/iv_event_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:alpha="0.4"
                    android:src="@drawable/bg_qr_placeholder" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/organize_select_picture"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>
            </RelativeLayout>

            <EditText
                android:id="@+id/et_title"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_admin_input"
                android:hint="@string/organize_title_hint"
                android:paddingHorizontal="20dp"
                android:textColor="?attr/colorAppTextPrimary"
                android:textColorHint="?attr/colorAppTextMuted"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <EditText
                    android:id="@+id/et_location"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_admin_input"
                    android:hint="@string/organize_location_hint"
                    android:paddingHorizontal="20dp"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textColorHint="?attr/colorAppTextMuted"
                    android:textSize="15sp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_location"
                    android:layout_width="wrap_content"
                    android:layout_height="54dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/organize_pin_button"
                    app:backgroundTint="?attr/colorAppSurface" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_category"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_admin_input"
                android:hint="@string/organize_category_hint"
                android:paddingHorizontal="20dp"
                android:textColor="?attr/colorAppTextPrimary"
                android:textColorHint="?attr/colorAppTextMuted"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <EditText
                    android:id="@+id/et_date"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_admin_input"
                    android:hint="@string/hint_date"
                    android:paddingHorizontal="20dp"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textColorHint="?attr/colorAppTextMuted"
                    android:textSize="15sp"
                    android:focusable="false"
                    android:clickable="true"
                    android:layout_marginEnd="8dp"/>
                <EditText
                    android:id="@+id/et_time"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_admin_input"
                    android:hint="@string/hint_time"
                    android:paddingHorizontal="20dp"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textColorHint="?attr/colorAppTextMuted"
                    android:textSize="15sp"
                    android:focusable="false"
                    android:clickable="true"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <EditText
                    android:id="@+id/et_price"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_admin_input"
                    android:hint="@string/organize_price_hint"
                    android:paddingHorizontal="20dp"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textColorHint="?attr/colorAppTextMuted"
                    android:textSize="15sp"
                    android:inputType="number"
                    android:layout_marginEnd="8dp"/>
                <EditText
                    android:id="@+id/et_slots"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_admin_input"
                    android:hint="@string/organize_slots_hint"
                    android:paddingHorizontal="20dp"
                    android:textColor="?attr/colorAppTextPrimary"
                    android:textColorHint="?attr/colorAppTextMuted"
                    android:textSize="15sp"
                    android:inputType="number"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <EditText
                android:id="@+id/et_description"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_admin_input"
                android:hint="@string/organize_description_hint"
                android:gravity="top"
                android:padding="20dp"
                android:textColor="?attr/colorAppTextPrimary"
                android:textColorHint="?attr/colorAppTextMuted"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_save_changes"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="20dp"
        android:backgroundTint="@color/primary_purple"
        android:text="@string/edit_event_save_button"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
