<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="?attr/colorAppSurface"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_admin_event_image"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="12dp"
            android:scaleType="centerCrop"
            android:background="?attr/colorAppSurface"
            android:src="@drawable/ic_launcher_background"
            android:contentDescription="@string/admin_event_image_desc" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_admin_event_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorAppTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_admin_event_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorAppTextMuted"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tv_admin_event_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/primary_purple"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_view_event"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/admin_view_button"
                android:backgroundTint="@color/primary_purple"
                android:textColor="@color/white"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btn_delete_event"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_delete_button"
                android:backgroundTint="#FF5252"
                android:textColor="@color/white"
                android:textSize="12sp"/>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_admin_share_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_admin_share_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/primary_purple"
            android:text="@string/share_invite_code"
            android:textColor="@color/white"
            android:textSize="13sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_admin_share_whatsapp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/whatsapp_green"
            android:text="@string/share_via_whatsapp"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:icon="@drawable/ic_chat"
            app:iconTint="@color/white"
            app:iconGravity="textStart" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_admin_scan_entry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/scan_entry_title"
        android:textColor="@color/primary_purple"
        android:textSize="13sp"
        app:icon="@drawable/ic_qr_scanner"
        app:iconTint="@color/primary_purple"
        app:iconGravity="textStart"
        app:strokeColor="@color/primary_purple"
        android:visibility="gone"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

</LinearLayout>
